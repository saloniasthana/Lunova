# PostgreSQL connection string (docker-compose.yml exposes Postgres on port 5433)
DATABASE_URL="postgresql://lunova:lunova@localhost:5433/lunova?schema=public"

# Required. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional — enables "Continue with Google". Leave empty to disable.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
